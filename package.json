{
  "name": "inkling",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "tsc --noEmit",
    "db:up": "docker compose --env-file .env.local -f deploy/docker-compose.yml up -d",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:roundtrip": "node --env-file-if-exists=.env.local --import tsx scripts/sync-roundtrip.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "token": "node --env-file-if-exists=.env.local --import tsx scripts/mint-token.mjs",
    "mcp:smoke": "node --env-file-if-exists=.env.local --import tsx scripts/mcp-smoke.mjs",
    "chatgpt:login": "node --env-file-if-exists=.env.local --import tsx scripts/chatgpt-login.ts",
    "chatgpt:import": "node --env-file-if-exists=.env.local --import tsx scripts/chatgpt-import.ts",
    "chatgpt:logout": "node --env-file-if-exists=.env.local --import tsx scripts/chatgpt-logout.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.13",
    "@llamaindex/liteparse-wasm": "2.15.1",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.53.0",
    "next": "^16.4.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
