# Server-side only. Visitors can also paste their own key in the app.
TOGETHER_API_KEY=

# Postgres. Self-hosted: `npm run db:up` (see deploy/docker-compose.yml), then `npm run db:migrate`.
# POSTGRES_PASSWORD is read by docker compose. Use the same password in DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://gloss:password@127.0.0.1:5432/gloss

# Clerk. Accounts are optional; signed in, notes and highlights sync across devices.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The public origin, for canonical and social card URLs.
NEXT_PUBLIC_SITE_URL=https://usegloss.io

# Exa web search, for Fact-check and questions asked with Web on. Optional: without it answers stay inside the text.
EXA_API_KEY=

# LlamaParse, behind "Read it more carefully" on hard PDFs. Optional; only readers with their own Together key can use it.
LLAMA_CLOUD_API_KEY=
