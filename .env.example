# Server-side only. Visitors can also paste their own key in the app.
# LLM_API_KEY is preferred. TOGETHER_API_KEY still works as a fallback.
TOGETHER_API_KEY=
LLM_API_KEY=
# OpenAI-compatible base. Unset uses Together.
LLM_BASE_URL=
# One model, or a list: key:id:label,key:id:label
LLM_MODEL=
LLM_MODEL_FAST=
LLM_MODELS=
# JSON merged into each chat body. Unset sends Together's chat_template_kwargs only on Together.
LLM_EXTRA_BODY=
# Dollars per million tokens. Unset is Together's price on Together, and 0 elsewhere (no free-budget math).
LLM_PRICE_IN=
LLM_PRICE_OUT=
LLM_PRICE_CACHED=
# Skip the /models key check (local servers that have no listing).
LLM_SKIP_KEY_CHECK=
# Painted covers. FEATURE_COVERS=0 turns them off. Otherwise Together, or COVERS_BASE_URL + COVERS_MODEL.
FEATURE_COVERS=
COVERS_BASE_URL=
COVERS_MODEL=
COVERS_API_KEY=
# Scanned PDFs. FEATURE_VISION=0 turns them off. Elsewhere set VISION_MODEL.
FEATURE_VISION=
VISION_MODEL=
VISION_LAYOUT_MODEL=

# Read aloud. together (default) | openai-compatible | off
# openai-compatible is POST {TTS_BASE_URL}/audio/speech (Kokoro-FastAPI uses model kokoro and a voice like af_heart).
# Example: TTS_BASE_URL=http://127.0.0.1:8880/v1
TTS_PROVIDER=
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
# Optional picker: id:Label,id:Label
TTS_VOICES=

# Postgres. Self-hosted: `npm run db:up` (see deploy/docker-compose.yml), then `npm run db:migrate`.
# POSTGRES_PASSWORD is read by docker compose. Use the same password in DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://gloss:password@127.0.0.1:5432/gloss

# single (default, one reader, no Clerk) or clerk.
AUTH_MODE=single
SINGLE_USER_ID=owner
# Comma-separated Tailscale logins allowed to use the server. Unset allows local use.
ALLOWED_TS_USERS=

# Clerk, only when AUTH_MODE=clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The public origin, for canonical and social card URLs.
# On a tailnet this is https://<host>.<tailnet>.ts.net
NEXT_PUBLIC_SITE_URL=https://usegloss.io

# X and Twitter status links. fx uses fxtwitter and needs no key. api needs a bearer token.
# A deleted or protected post is not retried on the other source.
X_FETCH=fx,api
X_BEARER_TOKEN=

# Exa web search, for Fact-check and questions asked with Web on. Optional: without it answers stay inside the text.
EXA_API_KEY=

# LlamaParse, behind "Read it more carefully" on hard PDFs. Optional; only readers with their own Together key can use it.
LLAMA_CLOUD_API_KEY=
